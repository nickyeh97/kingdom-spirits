<Project Sdk="Microsoft.NET.Sdk">
  <!--
    不需要 Unity 授權的編譯檢查：用 NuGet 上的 UnityEngine 模組參考組件編譯 Assets/Core 與 Assets/Runtime。
    抓得到型別錯誤、撞名（例如自訂類別與 UnityEngine.Display 同名）、語法超過 C# 9 等問題；
    抓不到執行期行為，也不檢查 Editor 腳本。參考組件是 2021.3 版，只用它有的 API 才會過——
    遇到 Unity 6 新增的 API 時，改以 Unity 端 CI 為準。
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>UNITY_WEBGL</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Core/**/*.cs" />
    <Compile Include="../../Assets/Runtime/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
  </ItemGroup>
</Project>
